class nv_form_spin: nv_form_input {
	double __min = 0, __max = 100, step = 1, page = 10;
	nv_form_spin(nv_form@parent, const string &in caption, const string &in id = "") {
		super(@parent, caption, id);
		type = nv_form_ct_spin;
		set_chars();
		if (this.page <= 0) this.page = this.step * 10;
		default_text = min;
	}
	void set_chars() {
		string chars = "0123456789";
		if (min < 0) chars += "-";
		if (string(step).find(".") > -1) chars += ".";
		set_disallowed_chars(chars, true);
	}
	double min {
		get const {
			return __min;
		}
		set {
			__min = value;
			set_chars();
		}
	}
	double max {
		get const {
			return __max;
		}
		set {
			__max = value;
			set_chars();
		}
	}
	bool handle_input() {
		if (!read_only) {
			if (key_repeating(KEY_UP)) {
				double t = parse_float(text) + this.step;
				if (text == "") t = min;
				if (t > max) t = max;
				unselect(true);
				text = t;
				cursor = 0;
				previous_line();
				return true;
			} else if (key_repeating(KEY_DOWN)) {
				double t = parse_float(text) - step;
				if (text == "") t = min;
				if (t < min) t = min;
				unselect(true);
				text = t;
				cursor = 0;
				next_line();
				return true;
			} else if (key_repeating(KEY_PAGEUP)) {
				double t = parse_float(text) + page;
				if (text == "") t = min;
				if (t > max) t = max;
				unselect(true);
				text = t;
				cursor = 0;
				previous_line();
				return true;
			} else if (key_repeating(KEY_PAGEDOWN)) {
				double t = parse_float(text) - page;
				if (text == "") t = min;
				if (t < min) t = min;
				unselect(true);
				text = t;
				cursor = 0;
				next_line();
				return true;
			} else if (keyboard_modifiers & KEYMOD_CTRL != 0 && key_pressed(KEY_HOME)) {
				unselect(true);
				text = min;
				cursor = 0;
				previous_line();
				return true;
			} else if (keyboard_modifiers & KEYMOD_CTRL != 0 && key_pressed(KEY_END)) {
				unselect(true);
				text = max;
				cursor = 0;
				next_line();
				return true;
			}
		}
		return nv_form_input::handle_input();
	}
	bool add(const string &in character, bool silent = false) {
		string new_text = text;
		bool prevselect = false;
		if (sel_start > -1 && sel_end > -1) {
			cursor = sel_start;
			new_text = text.substr(0, cursor) + text.substr(sel_end + 1);
			sel_start = -1;
			sel_end = -1;
			prevselect = true;
			if (!silent) speak(highlight_unselect_speech_text);
		}
		if ((max_length > 0) && (new_text.length() >= max_length))
			return false;
		new_text = new_text.substr(0, cursor) + character + new_text.substr(cursor);
		if (read_only == false) {
			text = new_text;
			cursor += character.length();
		}
		if (echo_flag == textflag_entry_characters || echo_flag == textflag_entry_characters_words)
			speak(input_box_speak(find_appropriate_character(character)), !prevselect);
		if (nvform_word_separators .find(character) > -1 && (echo_flag == textflag_entry_words || echo_flag == textflag_entry_characters_words)) {
			int temp_position = cursor - 1;
			while (temp_position > 0 && (temp_position >= text.length() || nvform_word_separators .find(text[temp_position - 1]) < 0 && text[temp_position - 1] != "\n"))
				temp_position--;
			string word = read_word_from_position(temp_position);
			if (password_mask != "") {
				for (uint i = 0; i < word.length(); i++) word[i] = password_mask;
			}
			speak(word, echo_flag != textflag_entry_characters_words);
		}
		nv_form_input_event e(this);
		e.character = character;
		event.fire(e);
		double t = parse_float(text);
		if (t < min || t > max) {
			t = clamp(t, min, max);
			text = t;
			cursor = this.text.length();
		}
		return true;
	}
	double get_output() const property {
		return parse_double(text);
	}
}
